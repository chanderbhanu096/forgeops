# ForgeOps AI — Environment Configuration
# Copy to .env and fill in your values. Never commit .env to git.

# ── Required ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Optional: fallback LLM ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=forgeops_dev

# ── MCP internal auth ────────────────────────────────────────────────────────
MCP_SECRET=forgeops_mcp_dev

# ── GitHub integration ───────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...

# ── Observability (optional, leave blank to skip) ────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Runtime ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
