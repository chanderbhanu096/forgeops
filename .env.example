# ForgeOps AI — Environment Configuration
# Copy to .env and fill in only the providers you want to enable.
# Never commit your real .env file or API keys.

# ── Default mission model ─────────────────────────────────────────────────────
# Use demo/forgeops-demo when no paid or hosted provider is configured.
DEFAULT_LLM_PROVIDER=demo
DEFAULT_LLM_MODEL=forgeops-demo

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODELS=gpt-5-mini,gpt-4.1-mini,gpt-4o-mini

# ── Anthropic / Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-sonnet-4-20250514,claude-opus-4-20250514

# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b

# ── OpenRouter ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=openrouter/auto

# ── Ollama ────────────────────────────────────────────────────────────────────
# The URL must point to Ollama's OpenAI-compatible /v1 endpoint.
# Example from Docker Desktop:
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=
OLLAMA_MODELS=llama3.2,qwen2.5-coder

# ── Any other OpenAI-compatible provider ──────────────────────────────────────
CUSTOM_OPENAI_NAME=Custom OpenAI-compatible
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_MODELS=

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=forgeops_dev

# ── MCP internal auth ────────────────────────────────────────────────────────
MCP_SECRET=forgeops_mcp_dev

# ── GitHub integration ───────────────────────────────────────────────────────
GITHUB_TOKEN=

# ── Observability ─────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Runtime ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
DEMO_MODE=false
